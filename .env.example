# Copie este arquivo para .env e preencha os valores antes de rodar o projeto.
# Nenhum destes valores tem default inseguro — Settings falha se algum faltar.

# --- LLM provider ---
# "bedrock" é o padrão e o único caminho de produção (Princípio I da constituição).
# "offline" é reservado à suíte de testes (LLM_PROVIDER=offline pytest), nunca use em execução real.
LLM_PROVIDER=bedrock

# --- Credenciais e região AWS ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Modelos Bedrock ---
# BEDROCK_MODEL_ID é invocado via Messages API (AnthropicBedrock, superfície
# atual do Bedrock para modelos Anthropic recentes como Claude Haiku 4.5 em
# diante) — diferente da integração legada (InvokeModel/Converse via boto3,
# usada apenas para modelos até Opus 4.6). O formato do próprio model_id
# varia por conta/região: pode ser um ID direto ou, como abaixo, um
# inference profile de cross-region (prefixo "us."/"eu." + sufixo de
# data/versão) quando o modelo não está disponível para invocação direta.
# Ver nota no README.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBEDDINGS_MODEL_ID=amazon.titan-embed-text-v2:0

# Cadeia de fallback (SPEC-005): lista de model_id adicionais, no mesmo
# formato do modelo primário acima (ID direto ou inference profile,
# dependendo do modelo), separados por vírgula, tentados em ordem caso
# BEDROCK_MODEL_ID falhe (throttling, indisponibilidade). Pode ficar vazia —
# nesse caso não há fallback. Ajuste para o(s) model_id(s) realmente
# habilitados na sua conta/região.
BEDROCK_FALLBACK_MODEL_IDS=

# --- API FastAPI (consumida como cliente HTTP pelo Report Consolidator, SPEC-014) ---
API_URL=http://localhost:8000

# --- Postgres / pgvector (SPEC-006) ---
POSTGRES_DSN=postgresql://pix:pix@localhost:5432/pix_compliance

# --- Object storage MinIO/S3-compatible (SPEC-006) ---
# Credenciais e bucket abaixo correspondem ao serviço `minio` local de
# docker-compose.yml (MINIO_ROOT_USER/MINIO_ROOT_PASSWORD) — troque
# OBJECT_STORAGE_ENDPOINT (e as credenciais, se aplicável) para apontar a um
# bucket S3 real; a mesma classe concreta (S3ObjectStore) serve os dois.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=pix-compliance
