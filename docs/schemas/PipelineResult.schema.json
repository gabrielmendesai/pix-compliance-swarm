{
  "$defs": {
    "EtapaMetric": {
      "additionalProperties": false,
      "description": "Métrica de uma etapa individual do pipeline orquestrado (SPEC-015).\n\nSempre registrada mesmo quando a etapa falha — `status` distingue uma\nfalha que abortou o pipeline (`falhou`) de uma que foi tolerada\nconforme sua política (`degradada`/`ignorada`).",
      "properties": {
        "duracao_segundos": {
          "minimum": 0,
          "title": "Duracao Segundos",
          "type": "number"
        },
        "nome": {
          "title": "Nome",
          "type": "string"
        },
        "status": {
          "enum": [
            "sucesso",
            "degradada",
            "ignorada",
            "falhou"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "nome",
        "duracao_segundos",
        "status"
      ],
      "title": "EtapaMetric",
      "type": "object"
    },
    "ReportOutput": {
      "additionalProperties": false,
      "description": "Metadados de saída de um relatório de conformidade gerado.",
      "properties": {
        "gerado_em": {
          "format": "date-time",
          "title": "Gerado Em",
          "type": "string"
        },
        "json_path": {
          "title": "Json Path",
          "type": "string"
        },
        "pdf_path": {
          "title": "Pdf Path",
          "type": "string"
        },
        "total_gaps": {
          "minimum": 0,
          "title": "Total Gaps",
          "type": "integer"
        },
        "total_normativos": {
          "minimum": 0,
          "title": "Total Normativos",
          "type": "integer"
        },
        "total_regras": {
          "minimum": 0,
          "title": "Total Regras",
          "type": "integer"
        }
      },
      "required": [
        "json_path",
        "pdf_path",
        "total_normativos",
        "total_regras",
        "total_gaps",
        "gerado_em"
      ],
      "title": "ReportOutput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Saída do agente orquestrador.",
  "properties": {
    "concluido_em": {
      "format": "date-time",
      "title": "Concluido Em",
      "type": "string"
    },
    "erro": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Erro"
    },
    "etapas": {
      "items": {
        "$ref": "#/$defs/EtapaMetric"
      },
      "title": "Etapas",
      "type": "array"
    },
    "iniciado_em": {
      "format": "date-time",
      "title": "Iniciado Em",
      "type": "string"
    },
    "pipeline_id": {
      "title": "Pipeline Id",
      "type": "string"
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReportOutput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sucesso": {
      "title": "Sucesso",
      "type": "boolean"
    }
  },
  "required": [
    "pipeline_id",
    "sucesso",
    "iniciado_em",
    "concluido_em"
  ],
  "title": "PipelineResult",
  "type": "object"
}
